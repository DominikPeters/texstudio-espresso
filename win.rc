#include "src/productversion.h"

IDI_ICON1               ICON    DISCARDABLE     "texstudio.ico"


1 VERSIONINFO
#ifdef TEXSTUDIO_TEXPRESSO
    FILEVERSION    4,9,9,1
    PRODUCTVERSION 4,9,9,1
#else
    FILEVERSION    0,0,0,0
    PRODUCTVERSION 0,0,0,0
#endif
{
    BLOCK "StringFileInfo"
    {
        BLOCK "000004B0"
        {
            VALUE "CompanyName",        "TeXstudio\0"
            VALUE "FileDescription",    "LaTeX editor\0"
            VALUE "FileVersion",        "git\0"
            VALUE "OriginalFilename",   "texstudio.exe\0"
#ifdef TEXSTUDIO_TEXPRESSO
            VALUE "ProductName",        "TeXstudio Espresso\0"
            VALUE "ProductVersion",     TEXSTUDIO_ESPRESSO_VERSION "\0"
#else
            VALUE "ProductName",        "TeXstudio\0"
            VALUE "ProductVersion",     "git\0"
#endif
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x0000, 0x04B0
    }
}
